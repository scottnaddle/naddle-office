      "id": "quote",
      "kind": "document-brief",
      "version": "1.0.0",
      "name": "견적서",
      "description": "품목·수량·단가와 유효기간을 정리한 견적 문서",
      "category": "영업",
      "tags": ["견적", "거래"],
      "previewText": "₩",
      "license": "Apache-2.0",
      "source": {
        "type": "self"
      },
      "author": "NaddleOffice",
      "locale": "ko",
      "sha256": null,
      "questions": [
        {
          "id": "customer",
          "label": "받는 곳(고객 또는 발주처)",
          "required": true,
          "placeholder": "예: ○○ 주식회사 구매팀"
        },
        {
          "id": "items",
          "label": "견적 항목과 수량·단가",
          "description": "한 줄에 하나씩 적어 주세요. 금액은 시스템이 합계를 정리합니다.",
          "multiline": true,
          "required": true,
          "placeholder": "예: 노트북 10대 × 1,500,000원"
        },
        {
          "id": "tax",
          "label": "세금 포함 여부",
          "options": [
            {
              "id": "included",
              "label": "부가세 포함"
            },
            {
              "id": "excluded",
              "label": "부가세 별도"
            }
          ],
          "required": true
        },
        {
          "id": "valid",
          "label": "견적 유효기간",
          "placeholder": "예: 발행일로부터 30일"
        }
      ],
      "sections": [
        {
          "id": "info",
          "title": "견적 정보"
        },
        {
          "id": "items",
          "title": "품목 및 금액"
        },
        {
          "id": "total",
          "title": "합계 및 조건"
        },
        {
          "id": "validity",
          "title": "유효기간 및 서명"
        }
      ]
    },
